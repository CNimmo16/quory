{
  "name": "@quory/core",
  "version": "7.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNimmo16/quory.git",
    "directory": "packages/core"
  },
  "description": "Quickly extract relationships from any database",
  "keywords": [
    "database",
    "schema",
    "relationships",
    "postgres",
    "mysql",
    "ERD",
    "entity-relationship-diagram",
    "Dijkstra",
    "graph"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "./dist/index.d.ts",
  "author": "CNimmo16",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@quory/config": "workspace:*",
    "@sqltools/formatter": "^1.2.5",
    "@types/lodash-es": "^4.17.12",
    "@types/pg": "^8.6.5",
    "@types/pluralize": "^0.0.29",
    "@types/string-similarity": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:",
    "better-sqlite3": "catalog:",
    "@types/better-sqlite3": "catalog:"
  },
  "dependencies": {
    "graph-data-structure": "^4.3.0",
    "lodash-es": "^4.17.21",
    "pluralize": "^8.0.0"
  }
}
