{
  "name": "@quory/stack",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNimmo16/quory.git",
    "directory": "packages/stack"
  },
  "description": "Integrate Quory into your existing web app",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./react/styles.css": {
      "import": "./dist/react/styles.css",
      "require": "./dist/react/styles.css"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./react/ui/button": {
      "types": "./dist/react/components/ui/button.d.ts",
      "import": "./dist/react/components/ui/button.js"
    },
    "./react/ui/popover": {
      "types": "./dist/react/components/ui/popover.d.ts",
      "import": "./dist/react/components/ui/popover.js"
    },
    "./react/ui/dropdown-menu": {
      "types": "./dist/react/components/ui/dropdown-menu.d.ts",
      "import": "./dist/react/components/ui/dropdown-menu.js"
    },
    "./react/ui/tooltip": {
      "types": "./dist/react/components/ui/tooltip.d.ts",
      "import": "./dist/react/components/ui/tooltip.js"
    },
    "./react/ui/command": {
      "types": "./dist/react/components/ui/command.d.ts",
      "import": "./dist/react/components/ui/command.js"
    },
    "./react/ui/dialog": {
      "types": "./dist/react/components/ui/dialog.d.ts",
      "import": "./dist/react/components/ui/dialog.js"
    },
    "./react/ui/input": {
      "types": "./dist/react/components/ui/input.d.ts",
      "import": "./dist/react/components/ui/input.js"
    },
    "./react/ui/badge": {
      "types": "./dist/react/components/ui/badge.d.ts",
      "import": "./dist/react/components/ui/badge.js"
    }
  },
  "author": "CNimmo16",
  "license": "MIT",
  "scripts": {
    "test": "jest --runInBand --passWithNoTests",
    "build": "tsup --entry src/server/index.ts --entry src/react/index.ts --entry src/browser/index.ts --entry src/react/components/ui/button.tsx --entry src/react/components/ui/popover.tsx --entry src/react/components/ui/dropdown-menu.tsx --entry src/react/components/ui/tooltip.tsx --entry src/react/components/ui/command.tsx --entry src/react/components/ui/dialog.tsx --entry src/react/components/ui/input.tsx --entry src/react/components/ui/badge.tsx --format cjs,esm --dts",
    "build:watch": "pnpm run build --watch --sourcemap",
    "lint": "eslint ."
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@quory/config": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/string-similarity": "catalog:",
    "better-sqlite3": "catalog:",
    "jest": "catalog:",
    "react-dom": "catalog:react19",
    "ts-jest": "catalog:",
    "tsup": "catalog:"
  },
  "dependencies": {
    "@quory/core": "workspace:*",
    "@quory/mysql": "workspace:*",
    "@quory/postgres": "workspace:*",
    "@quory/sqlite": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "classnames": "catalog:",
    "date-fns": "^4.1.0",
    "immer": "catalog:",
    "knex": "catalog:",
    "react": "catalog:react19",
    "react-icons": "catalog:",
    "string-similarity": "^4.0.4",
    "testcontainers": "catalog:",
    "zod": "catalog:",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "lucide-react": "^1.52.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "cmdk": "^1.1.1",
    "@radix-ui/react-dialog": "^1.2.0"
  }
}
