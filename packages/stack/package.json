{
  "name": "@quory/stack",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNimmo16/quory.git",
    "directory": "packages/stack"
  },
  "description": "Integrate Quory into your existing web app",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./react/styles.css": {
      "import": "./dist/react/styles.css",
      "require": "./dist/react/styles.css"
    }
  },
  "author": "CNimmo16",
  "license": "MIT",
  "scripts": {
    "test": "jest --runInBand --passWithNoTests",
    "build": "tsup --entry src/server/index.ts --entry src/react/index.ts --format cjs,esm --dts",
    "build:watch": "pnpm run build --watch --sourcemap",
    "lint": "eslint ."
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@quory/config": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/string-similarity": "catalog:",
    "better-sqlite3": "catalog:",
    "jest": "catalog:",
    "react-dom": "catalog:react19",
    "ts-jest": "catalog:",
    "tsup": "catalog:"
  },
  "dependencies": {
    "@quory/core": "workspace:*",
    "@quory/mysql": "workspace:*",
    "@quory/postgres": "workspace:*",
    "@quory/sqlite": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "classnames": "catalog:",
    "date-fns": "^4.1.0",
    "immer": "catalog:",
    "knex": "catalog:",
    "react": "catalog:react19",
    "react-icons": "catalog:",
    "string-similarity": "^4.0.4",
    "testcontainers": "catalog:",
    "zod": "catalog:"
  }
}
