{
  "name": "quory",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run build:watch",
    "serve": "pnpm --filter @quory/client run serve",
    "test": "pnpm -r --parallel run test",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "pnpm build && changeset",
    "ci:release": "pnpm build && pnpm lint && pnpm test && changeset version && changeset publish"
  },
  "devDependencies": {
    "node-gyp": "^10.3.1",
    "prettier": "2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.4"
  },
  "engines": {
    "pnpm": ">=12.0.0 <13",
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@changesets/cli": "^2.27.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "20.20.2",
      "onFail": "download"
    }
  }
}
