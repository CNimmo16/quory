{
  "name": "quory",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter './packages/*' -r run build",
    "dev": "pnpm --filter './packages/*' -r --parallel run build:watch",
    "serve": "pnpm --filter @quory/client run serve",
    "sakila:up": "docker compose -f compose.sakila.yml up --detach --wait --wait-timeout 180",
    "sakila:down": "docker compose -f compose.sakila.yml down",
    "sakila:reset": "docker compose -f compose.sakila.yml down --volumes && pnpm sakila:up",
    "sakila:logs": "docker compose -f compose.sakila.yml logs --follow mysql",
    "test": "pnpm --filter './packages/*' -r --parallel run test",
    "lint": "pnpm --filter './packages/*' -r run lint",
    "format": "prettier --config prettierrc.json --write \"**/*.{ts,tsx,astro,md,json}\"",
    "changeset": "pnpm build && changeset",
    "ci:release": "pnpm build && pnpm lint && pnpm test && changeset version && changeset publish",
    "marketing:dev": "pnpm --filter @quory/marketing dev",
    "marketing:build": "pnpm --filter @quory/marketing build",
    "marketing:start": "pnpm --filter @quory/marketing start",
    "rebuild:native": "pnpm --filter @quory/client rebuild:native"
  },
  "devDependencies": {
    "node-gyp": "^10.3.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier-plugin-tailwindcss-canonical-classes": "0.1.6",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "engines": {
    "pnpm": ">=12.0.0 <13",
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@changesets/cli": "^2.27.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  }
}
