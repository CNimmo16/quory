{
  "name": "@quory/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @quory/stack... build && astro dev --host 127.0.0.1 --port 4321",
    "build": "pnpm --filter @quory/stack... build && astro check && astro build",
    "start": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev",
    "test:worker": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "~0.37.7",
    "@quory/core": "workspace:*",
    "@quory/stack": "workspace:*",
    "astro": "5.18.2",
    "lucide-react": "^1.52.0",
    "openai": "^4.104.0",
    "posthog-js": "^1.438.12",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "sql.js": "1.15.1",
    "zod": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@posthog/cli": "^0.18.10",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@types/sql.js": "^1.4.11",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "catalog:",
    "wrangler": "4.151.1"
  }
}
