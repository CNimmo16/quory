{
  "name": "@quory/marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "start": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev",
    "test:worker": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/starlight": "~0.37.7",
    "astro": "5.18.2",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.3",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "wrangler": "4.151.1"
  }
}
