<!-- Static, theme-aware colour washes and a quiet data-grid texture. -->
<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none"
>
  <div
    class="absolute inset-x-0 top-0 h-275 max-h-full bg-[radial-gradient(ellipse_at_0%_10%,rgb(var(--primary)/0.12),transparent_60%),radial-gradient(ellipse_at_100%_25%,rgb(var(--secondary)/0.14),transparent_60%)] dark:opacity-70"
  >
  </div>
  <div
    class="absolute inset-x-0 top-0 h-200 max-h-full bg-[radial-gradient(rgb(var(--primary)/0.18)_0.8px,transparent_0.8px)] mask-[radial-gradient(ellipse_85%_85%_at_50%_0%,black_20%,transparent_100%)] bg-size-[24px_24px] dark:opacity-100"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-175 max-h-full bg-[radial-gradient(ellipse_at_30%_100%,rgb(var(--primary)/0.09),transparent_65%),radial-gradient(ellipse_at_100%_100%,rgb(var(--secondary)/0.1),transparent_55%)] dark:opacity-70"
  >
  </div>
</div>
