---
interface Props {
  label?: string;
  compactOnMobile?: boolean;
}
const { label = "GitHub", compactOnMobile = false } = Astro.props;
---

<a
  class="group inline-flex min-h-11 shrink-0 items-center justify-center gap-2.5 text-[14px] font-medium text-foreground hover:text-primary-emphasis max-[520px]:text-[12px]"
  href="https://github.com/CNimmo16/quory"
  aria-label={label}
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    class="block h-6 w-6 dark:hidden"
    src="/logos/github-black.svg"
    width="24"
    height="24"
    alt=""
  />
  <img
    class="hidden h-6 w-6 dark:block"
    src="/logos/github-white.svg"
    width="24"
    height="24"
    alt=""
  />
  <span
    class:list={[
      "underline decoration-current/40 underline-offset-[5px] group-hover:decoration-current",
      { "max-[520px]:hidden": compactOnMobile },
    ]}>{label}</span
  >
</a>
