---
interface Props {
  label?: string;
}
const { label = "GitHub" } = Astro.props;
---

<a
  class="group inline-flex min-h-11 shrink-0 items-center justify-center gap-2.5 text-[14px] font-medium text-black hover:text-primary-emphasis max-[520px]:text-[12px]"
  href="https://github.com/CNimmo16/quory"
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    class="block h-6 w-6 dark:hidden"
    src="/logos/github-black.svg"
    width="24"
    height="24"
    alt=""
  />
  <img
    class="hidden h-6 w-6 dark:block"
    src="/logos/github-white.svg"
    width="24"
    height="24"
    alt=""
  />
  <span
    class="underline decoration-current/40 underline-offset-[5px] group-hover:decoration-current"
    >{label}</span
  >
</a>
