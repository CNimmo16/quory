---
import SignupVerification from "./SignupVerification.astro";
---

<dialog
  class="m-auto max-h-[calc(100svh-40px)] w-[min(600px,calc(100%-40px))] rounded-[20px] border border-border bg-background p-9 text-foreground shadow-[0_24px_80px_rgb(var(--foreground)/0.18)] backdrop:bg-foreground/35 backdrop:backdrop-blur-[5px] max-[520px]:px-6 max-[520px]:pt-8 max-[520px]:pb-6"
  id="download-email-dialog"
  aria-labelledby="download-email-title"
  aria-describedby="download-email-description"
>
  <button
    class="close absolute top-3 right-3 size-9 rounded-full border-0 bg-transparent text-[26px] leading-none text-muted-foreground hover:bg-primary-subtle/50"
    type="button"
    aria-label="Close download dialog">×</button
  >
  <h2
    class="m-0 font-display text-[38px] leading-[1.1] max-[520px]:text-[34px]"
    id="download-email-title"
  >
    Pre-register for Quory cloud?
  </h2>
  <p
    class="my-4 text-sm/[1.7] text-muted-foreground"
    id="download-email-description"
  >
    We’re working hard to build a cloud-hosted version of Quory. Enter your
    email to stay in the loop. No spam, no data sharing, just updates from us
    about Quory.
  </p>
  <form method="dialog">
    <label class="mb-2 block text-[13px] font-medium" for="download-email"
      >Email address</label
    >
    <input
      class="w-full rounded-lg border border-border bg-background px-3.5 py-3 font-[inherit] text-sm/[inherit] text-foreground"
      id="download-email"
      type="email"
      autocomplete="email"
      placeholder="you@company.com"
      autofocus
    />
    <SignupVerification />
    <div class="mt-5 flex gap-2.5">
      <button
        class="flex flex-1 flex-col gap-0 rounded-lg border border-transparent bg-primary px-4.5 py-1.5 text-[13px] font-medium text-primary-foreground hover:bg-primary-hover"
        type="submit"
      >
        <span>Continue to download</span>
        <p
          class="text-xs/[inherit] font-medium text-primary-subtle"
          data-selected-installer
        >
        </p>
      </button>
      <button
        class="skip rounded-lg border border-border bg-transparent px-4.5 py-1.5 text-[13px] font-medium text-muted-foreground hover:bg-primary-subtle/50 hover:text-foreground"
        type="button">No thanks - just download</button
      >
    </div>
  </form>
</dialog>

<script>
  import { targets, osNames, type OS } from "../lib/downloads";
  import { signupForm } from "../lib/signup";

  const dialog = document.querySelector<HTMLDialogElement>(
    "#download-email-dialog",
  )!;
  const form = dialog.querySelector<HTMLFormElement>("form")!;
  const signup = signupForm(form);
  const submit = form.querySelector<HTMLButtonElement>("[type=submit]")!;
  let sending = false;
  let generation = 0;
  let destination: string | undefined;
  let returnFocus: HTMLElement | undefined;

  document.addEventListener("click", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>("a[data-download-email]")
        : null;
    if (!link?.hasAttribute("href")) return;
    const url = new URL(link.href);
    const target = targets.find(
      (target) => url.pathname === `/downloads/install/${target.id}/`,
    );
    if (url.origin !== window.location.origin || !target) return;

    event.preventDefault();
    destination = link.href;
    const picker = link.closest<HTMLElement>("[data-download-picker]");
    returnFocus = picker
      ? (picker
          .closest("[data-download-widget]")
          ?.querySelector<HTMLElement>("[data-download-toggle]") ?? link)
      : link;
    if (picker?.matches(":popover-open")) picker.hidePopover();
    dialog.querySelector("[data-selected-installer]")!.textContent =
      `${osNames[target.os as OS]} · ${target.label}`;
    form.reset();
    signup.message("");
    dialog.showModal();
    void signup.prepare();
  });

  function continueDownload() {
    if (!destination) return;
    const href = destination;
    dialog.close();
    window.location.assign(href);
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    const email = form
      .querySelector<HTMLInputElement>("#download-email")!
      .value.trim();
    if (!email) {
      continueDownload();
      return;
    }
    const current = generation;
    sending = true;
    submit.disabled = true;
    signup.message("Sending your confirmation email…");
    try {
      await signup.submit(email, "download");
      if (current === generation && dialog.open) continueDownload();
    } catch (error) {
      if (current === generation && dialog.open) {
        signup.message(
          error instanceof Error
            ? error.message
            : "Signup failed. Please try again, or skip to download.",
          true,
        );
        void signup.prepare();
      }
    } finally {
      if (current === generation) {
        sending = false;
        submit.disabled = false;
      }
    }
  });
  dialog.querySelector(".skip")!.addEventListener("click", continueDownload);
  dialog
    .querySelector(".close")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom
    )
      dialog.close();
  });
  dialog.addEventListener("close", () => {
    generation++;
    sending = false;
    submit.disabled = false;
    form.reset();
    destination = undefined;
    returnFocus?.focus({ preventScroll: true });
    returnFocus = undefined;
  });
</script>
