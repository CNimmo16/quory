---
import iconUrl from "../../../../packages/config/branding/quory-icon.svg?url";
---

<section id="cloud" class="cloud" aria-labelledby="cloud-title">
  <div class="cloud-copy">
    <p class="eyebrow">
      Quory Cloud
      <span class="badge"><span aria-hidden="true"></span>Coming soon</span>
    </p>
    <h2 id="cloud-title">The same clarity.<br />Shared with your team.</h2>
    <p class="intro">
      We’re working on a hosted version of Quory. A shared place for your team
      to explore customer data, with less setup to manage.
    </p>
    <div class="download">
      <p>Quory cloud is coming soon. The desktop app is available today.</p>
      <div class="cloud-actions">
        <button
          class="interest-button"
          id="cloud-interest-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="cloud-interest-dialog"
        >
          Register your interest
        </button>
        <a href="https://github.com/CNimmo16/quory/releases/latest">
          Get the desktop app
        </a>
      </div>
    </div>
  </div>
  <div class="illustration" aria-hidden="true">
    <div class="constellation">
      <div class="orbit orbit-outer"></div>
      <div class="orbit orbit-inner"></div>
      <svg class="connections" viewBox="0 0 480 440" fill="none">
        <path
          d="M105 95H160Q180 95 180 115V200Q180 220 200 220H240M385 155H330Q310 155 310 175V200Q310 220 290 220H240M130 355H175Q195 355 195 335V240Q195 220 215 220H240"
        ></path>
        <path
          class="signal"
          d="M105 95H160Q180 95 180 115V200Q180 220 200 220H240M385 155H330Q310 155 310 175V200Q310 220 290 220H240M130 355H175Q195 355 195 335V240Q195 220 215 220H240"
        ></path>
      </svg>
      <div class="data-card card-back">
        <div class="card-heading"><i></i><span></span></div>
        <div class="data-grid">{Array.from({ length: 9 }, () => <span />)}</div>
      </div>
      <div class="data-card card-front">
        <div class="card-heading"><i></i><span></span></div>
        <div class="data-grid">{Array.from({ length: 9 }, () => <span />)}</div>
      </div>
      <div class="hub">
        <img src={iconUrl} width="58" height="58" alt="" />
      </div>
      <div class="avatar avatar-one">AM<span></span></div>
      <div class="avatar avatar-two">JL<span></span></div>
      <div class="avatar avatar-three">SK<span></span></div>
      <span class="spark spark-one">✳</span>
      <span class="spark spark-two"></span>
    </div>
  </div>
</section>

<dialog
  id="cloud-interest-dialog"
  class="interest-dialog"
  aria-labelledby="interest-title"
  aria-describedby="interest-description"
>
  <button
    class="dialog-close"
    type="button"
    aria-label="Close registration dialog">×</button
  >
  <p class="eyebrow">Quory Cloud</p>
  <h2 id="interest-title">Register your interest</h2>
  <p id="interest-description">We’re building Quory Cloud. We’ll let you know when it’s ready for your team.</p>
  <form>
    <label for="cloud-interest-email">Email address</label>
    <input
      id="cloud-interest-email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder="you@company.com"
      required
      autofocus
    />
    <button
      class="interest-button"
      type="submit"
      disabled
      aria-describedby="interest-status">Register your interest</button
    >
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "#cloud-interest-dialog",
  );
  const trigger = document.querySelector<HTMLButtonElement>(
    "#cloud-interest-open",
  );
  if (dialog && trigger) {
    trigger.addEventListener("click", () => dialog.showModal());
    dialog
      .querySelector(".dialog-close")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close();
    });
    // Keep the preview form local until registration is connected.
    dialog
      .querySelector("form")
      ?.addEventListener("submit", (event) => event.preventDefault());
  }
</script>

<style>
  .cloud-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .interest-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 12px 18px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: rgb(var(--primary));
    color: rgb(var(--primary-foreground));
    font-size: 13px;
    font-weight: 500;
    transition: background 180ms;
  }
  .interest-button:hover:not(:disabled) {
    background: rgb(var(--primary-hover));
  }
  .interest-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .interest-dialog {
    width: min(460px, calc(100% - 40px));
    max-height: calc(100svh - 40px);
    margin: auto;
    padding: 36px;
    border: 1px solid rgb(var(--border));
    border-radius: 20px;
    background: rgb(var(--background));
    color: rgb(var(--foreground));
    box-shadow: 0 24px 80px rgb(var(--foreground) / 0.18);
  }
  .interest-dialog::backdrop {
    background: rgb(var(--foreground) / 0.35);
    backdrop-filter: blur(5px);
  }
  .dialog-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgb(var(--muted-foreground));
    font-size: 26px;
    line-height: 1;
  }
  .dialog-close:hover {
    background: rgb(var(--muted));
  }
  .interest-dialog .eyebrow {
    margin-bottom: 18px;
  }
  .interest-dialog h2 {
    font-size: 38px;
  }
  #interest-description {
    margin: 14px 0 28px;
    color: rgb(var(--muted-foreground));
    font-size: 13px;
  }
  .interest-dialog label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 500;
  }
  .interest-dialog input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid rgb(var(--border));
    border-radius: 8px;
    background: rgb(var(--background));
    color: rgb(var(--foreground));
    font: inherit;
    font-size: 16px;
  }
  .interest-dialog input:focus-visible {
    outline: 2px solid rgb(var(--primary));
    outline-offset: 3px;
  }
  .interest-dialog form > button {
    width: 100%;
    margin-top: 20px;
  }
  #interest-status {
    margin: 12px 0 0;
    text-align: center;
    color: rgb(var(--muted-foreground));
    font-size: 11px;
  }
  @media (max-width: 520px) {
    .interest-dialog {
      padding: 32px 24px;
    }
  }
  .cloud {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    width: min(1240px, calc(100% - 96px));
    margin: 60px auto 100px;
    overflow: hidden;
    border: 1px solid rgb(var(--primary) / 0.16);
    border-radius: 24px;
    background: linear-gradient(
      120deg,
      rgb(var(--primary-subtle) / 0.3),
      rgb(var(--muted) / 0.55)
    );
  }
  .cloud-copy {
    position: relative;
    z-index: 1;
    padding: 64px 0 64px 64px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0 0 28px;
    color: rgb(var(--primary-emphasis));
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border: 1px solid rgb(var(--primary) / 0.2);
    border-radius: 100px;
    background: rgb(var(--background) / 0.6);
    font-size: 10px;
    letter-spacing: 0;
    text-transform: none;
  }
  .badge > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--primary));
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 4.3vw, 60px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.5px;
  }
  .intro {
    max-width: 390px;
    margin: 24px 0 0;
    color: rgb(var(--muted-foreground));
    font-size: 14px;
    line-height: 1.85;
  }
  .download {
    margin-top: 36px;
  }
  .download p {
    margin: 0 0 14px;
    color: rgb(var(--muted-foreground));
    font-size: 11px;
    line-height: 1.7;
  }
  .download a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 12px 18px;
    border: 1px solid rgb(var(--primary) / 0.3);
    border-radius: 8px;
    background: rgb(var(--background) / 0.7);
    font-size: 13px;
    font-weight: 500;
    transition:
      background 180ms,
      transform 180ms;
  }
  .download a:hover {
    background: rgb(var(--primary-subtle));
    transform: translateY(-2px);
  }
  .download a > span {
    color: rgb(var(--primary-emphasis));
    font-size: 20px;
    line-height: 1;
  }
  .illustration {
    display: grid;
    place-items: center;
    align-self: stretch;
    min-width: 0;
    background: radial-gradient(
      ellipse at center,
      rgb(var(--primary) / 0.13),
      transparent 68%
    );
  }
  .constellation {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 480 / 440;
  }
  .orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    aspect-ratio: 1;
    border: 1px solid rgb(var(--primary) / 0.13);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .orbit-outer {
    width: 92%;
  }
  .orbit-inner {
    width: 65%;
    border-style: dashed;
  }
  .connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: rgb(var(--primary) / 0.25);
    stroke-width: 1.5;
  }
  .connections .signal {
    stroke: rgb(var(--primary));
    stroke-dasharray: 8 240;
    animation: signal 10s linear infinite;
  }
  .hub {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 29%;
    aspect-ratio: 1;
    border: 1px solid rgb(var(--primary) / 0.22);
    border-radius: 24%;
    background: rgb(var(--background));
    box-shadow:
      0 18px 45px -18px rgb(var(--primary) / 0.4),
      0 0 0 8px rgb(var(--background) / 0.4);
    transform: translate(-50%, -50%);
  }
  .hub img {
    width: 42%;
    height: auto;
  }
  .hub > span {
    color: rgb(var(--muted-foreground));
    font-size: 10px;
    letter-spacing: 0.5px;
  }
  .data-card {
    position: absolute;
    width: 30%;
    padding: 14px;
    border: 1px solid rgb(var(--primary) / 0.18);
    border-radius: 10px;
    background: rgb(var(--background) / 0.85);
    box-shadow: 0 12px 28px -18px rgb(var(--primary) / 0.4);
  }
  .card-back {
    left: 12%;
    top: 34%;
    transform: rotate(-9deg);
  }
  .card-front {
    right: 9%;
    bottom: 17%;
    transform: rotate(7deg);
  }
  .card-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 13px;
  }
  .card-heading i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: rgb(var(--primary) / 0.3);
  }
  .card-heading > span {
    width: 46%;
    height: 5px;
    border-radius: 2px;
    background: rgb(var(--muted-foreground) / 0.25);
  }
  .data-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.8fr;
    gap: 9px 7px;
    padding-top: 10px;
    border-top: 1px solid rgb(var(--border));
  }
  .data-grid > span {
    height: 4px;
    border-radius: 2px;
    background: rgb(var(--primary) / 0.15);
  }
  .avatar {
    position: absolute;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 11%;
    aspect-ratio: 1;
    border: 4px solid rgb(var(--background));
    border-radius: 50%;
    font-size: 12px;
    box-shadow: 0 8px 20px -10px rgb(var(--primary) / 0.35);
  }
  .avatar-one {
    left: 16.4%;
    top: 15.6%;
    color: rgb(var(--primary-emphasis));
    background: rgb(var(--primary-subtle));
  }
  .avatar-two {
    left: 74.7%;
    top: 29.2%;
    color: rgb(var(--secondary-emphasis));
    background: rgb(var(--secondary-subtle));
  }
  .avatar-three {
    left: 21.6%;
    top: 74.7%;
    color: rgb(var(--primary-emphasis));
    background: rgb(var(--primary-subtle));
  }
  .avatar > span {
    position: absolute;
    right: -2px;
    bottom: 0;
    width: 11px;
    height: 11px;
    border: 2px solid rgb(var(--background));
    border-radius: 50%;
    background: rgb(var(--primary));
  }
  .spark {
    position: absolute;
    color: rgb(var(--primary) / 0.55);
  }
  .spark-one {
    right: 28%;
    top: 14%;
    font-size: 28px;
  }
  .spark-two {
    left: 9%;
    bottom: 31%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  @keyframes signal {
    to {
      stroke-dashoffset: -496;
    }
  }
  @media (max-width: 1100px) {
    .cloud {
      width: calc(100% - 64px);
    }
    .cloud-copy {
      padding: 44px 0 44px 36px;
    }
    h2 {
      font-size: 44px;
    }
    .intro {
      font-size: 13px;
    }
  }
  @media (max-width: 780px) {
    .cloud {
      width: calc(100% - 40px);
      grid-template-columns: 1fr;
      margin: 40px auto 64px;
    }
    .cloud-copy {
      padding: 36px 28px 0;
    }
    .eyebrow {
      margin-bottom: 22px;
    }
    h2 {
      font-size: clamp(38px, 7vw, 50px);
    }
    .intro {
      max-width: 460px;
      margin-top: 20px;
    }
    .download {
      margin-top: 28px;
    }
    .illustration {
      padding: 0 12px;
    }
    .constellation {
      max-width: 400px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .connections .signal {
      animation: none;
    }
  }
</style>
