      >
        <table
          class="w-full border-collapse text-left text-[7px] whitespace-nowrap max-[520px]:text-[5.5px] [&_td]:border [&_td]:border-solid [&_td]:border-muted [&_td]:px-2 [&_td]:py-[7px] [&_td]:text-muted-foreground max-[520px]:[&_td]:px-1 max-[520px]:[&_td]:py-[6px] [&_td:first-child]:font-mono [&_td:first-child]:text-primary-emphasis [&_th]:border [&_th]:border-solid [&_th]:border-muted [&_th]:bg-background [&_th]:px-2 [&_th]:py-[7px] [&_th]:font-medium [&_th]:text-muted-foreground max-[520px]:[&_th]:px-1 max-[520px]:[&_th]:py-[6px] [&_th_small]:ml-[6px] [&_th_small]:text-[5px] [&_th_small]:font-normal [&_th_small]:text-muted-foreground max-[520px]:[&_th_small]:ml-[2px] max-[520px]:[&_th_small]:text-[4px]"
        >
          <caption
            class="sr-only absolute m-[-1px] h-[1px] w-[1px] overflow-hidden border-0 border-solid p-0 whitespace-nowrap [clip:rect(0,_0,_0,_0)]"
          >
            Example records
          </caption>
          <thead>
            <tr id="preview-columns">
              <th>
                id <small>int</small>
              </th>
