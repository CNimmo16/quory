      >
        <span
          class="inline-block h-1 w-1 shrink-0 rounded-full bg-muted-foreground"
        ></span>
        <span class="font-mono" id="preview-count"> 1 record found</span>
        <span class="ml-auto text-[5px] max-[520px]:text-[4px]">
