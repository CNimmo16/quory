</div>
<div
  class="absolute right-[15px] bottom-[-2px] flex [transform:rotate(1deg)] items-center gap-[10px] rounded-[7px] border border-solid border-primary-subtle bg-card px-[19px] py-[13px] shadow-[0_8px_20px_rgb(var(--primary-emphasis)_/_0.063)] max-[1100px]:right-0 max-[1100px]:p-[10px] max-[780px]:right-4 max-[780px]:px-[19px] max-[780px]:py-[13px] max-[520px]:right-[7px] max-[520px]:bottom-0 max-[520px]:gap-2 max-[520px]:px-3 max-[520px]:py-[10px]"
>
  <span
    class="grid h-[25px] w-[25px] place-items-center rounded-full bg-muted text-[12px] text-muted-foreground max-[520px]:h-[22px] max-[520px]:w-[22px] max-[520px]:text-[10px]"
  >
    ✓
  </span>
  <div>
    <strong
      class="block text-[9px] font-medium max-[1100px]:text-[8px] max-[780px]:text-[9px] max-[520px]:text-[7px]"
    >
      A customer. Their orders. The full story.
    </strong>
    <span class="block text-[8px] text-muted-foreground max-[520px]:text-[6px]">
      Connected in a few clicks.
    </span>
  </div>
</div>
<script>
  const examples = {
    customers: {
      filter: "email",
      value: "alex@example.com",
      columns: [
        ["id", "int"],
        ["name", "text"],
        ["email", "text"],
      ],
      rows: [["1042", "Alex Morgan", "alex@example.com"]],
    },
    orders: {
      filter: "customer_id",
      value: "1042",
      columns: [
        ["id", "int"],
        ["customer_id", "int"],
        ["status", "text"],
      ],
      rows: [
        ["2081", "1042", "Delivered"],
        ["2094", "1042", "Processing"],
      ],
    },
    payments: {
      filter: "order_id",
      value: "2081, 2094",
      columns: [
        ["id", "int"],
        ["order_id", "int"],
        ["status", "text"],
      ],
      rows: [
        ["3102", "2081", "Paid"],
        ["3103", "2094", "Pending"],
      ],
    },
  };
  function selectTable(name: keyof typeof examples) {
    const example = examples[name];
    document
      .querySelectorAll<HTMLButtonElement>(".table-tab")
      .forEach((tab) => {
        const active = tab.dataset.table === name;
        tab.setAttribute("aria-pressed", String(active));
      });
    document.querySelector("#preview-table-name")!.textContent = name;
    document.querySelector("#preview-filter")!.textContent = example.filter;
    document.querySelector("#preview-value")!.textContent = example.value;
    document.querySelector("#preview-count")!.textContent = `${
      example.rows.length
    } record${example.rows.length === 1 ? "" : "s"} found`;
    const columns = document.querySelector("#preview-columns")!;
    columns.replaceChildren(
      ...example.columns.map(([name, type]) => {
        const th = document.createElement("th");
        th.textContent = `${name} `;
        const small = document.createElement("small");
        small.textContent = type;
        th.append(small);
        return th;
      }),
    );
    const rows = document.querySelector("#preview-rows")!;
    rows.replaceChildren(
      ...example.rows.map((cells) => {
        const tr = document.createElement("tr");
        cells.forEach((value) => {
          const td = document.createElement("td");
          td.textContent = value;
          if (/^\d+(?:\.\d+)?$/.test(value)) td.classList.add("font-mono");
          tr.append(td);
        });
        return tr;
      }),
    );
  }
  document
    .querySelectorAll<HTMLButtonElement>(".table-tab")
    .forEach((tab) =>
      tab.addEventListener("click", () =>
        selectTable(tab.dataset.table as keyof typeof examples),
      ),
    );
  document
    .querySelectorAll<HTMLButtonElement>(".relationship-button")
    .forEach((button) =>
      button.addEventListener("click", () =>
        selectTable(button.dataset.target as keyof typeof examples),
      ),
    );
</script>
