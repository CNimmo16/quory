      <div
        class="mb-[7px] flex items-center gap-2 rounded-[5px] border border-solid border-primary-subtle bg-card p-2 max-[520px]:gap-[5px] max-[520px]:p-[6px]"
      >
        <div
          class="grid h-6 w-6 place-items-center rounded-[5px] bg-muted text-[14px] text-muted-foreground max-[520px]:h-5 max-[520px]:w-5 max-[520px]:text-[12px]"
        >
          ▦
        </div>
        <div>
          <strong
            class="block text-[8px] font-medium text-primary-emphasis max-[520px]:text-[6px]"
          >
            payments
          </strong>
          <span
            class="block font-mono text-[5.5px] text-muted-foreground max-[520px]:text-[4px]"
          >
            orders.id → payments.order_id
          </span>
        </div>
        <button
          class="relationship-button ml-auto grid h-5 w-5 place-items-center rounded border border-solid border-primary-subtle bg-white p-0 text-[11px] text-muted-foreground hover:bg-primary-subtle max-[520px]:h-[18px] max-[520px]:w-[18px] max-[520px]:text-[10px]"
