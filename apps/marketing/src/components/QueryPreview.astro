                name <small>text</small>
              </th>
              <th>
                email <small>text</small>
              </th>
            </tr>
          </thead>
          <tbody id="preview-rows">
            <tr>
              <td>1042</td>
              <td>Alex Morgan</td>
              <td>alex@example.com</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="mx-0 mt-[18px] mb-[9px] flex items-center gap-[5px] text-[7px] text-muted-foreground max-[520px]:mt-[13px] max-[520px]:gap-[3px] max-[520px]:text-[5.5px] min-[1450px]:mt-6"
      >
        <span class="text-[14px]">↳</span> Follow a relationship{" "}
        <span
          class="ml-auto text-[6px] text-muted-foreground max-[520px]:text-[4px]"
