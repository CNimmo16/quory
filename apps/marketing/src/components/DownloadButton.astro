---
import PlatformIcon from "./PlatformIcon.astro";
import {
  fallbackManifest,
  targets,
  osNames,
  installerPageURL,
  type OS,
} from "../lib/downloads";
interface Props {
  compact?: boolean;
  variant?: "primary" | "secondary";
}
const { compact = false, variant = "primary" } = Astro.props;
const menuId = `download-platforms-${crypto.randomUUID()}`;
---

<div
  class="group/download relative inline-flex"
  data-variant={variant}
  data-compact={compact}
  data-download-widget
>
  <div
    class="inline-flex rounded-lg bg-primary text-primary-foreground group-data-[variant=secondary]/download:border group-data-[variant=secondary]/download:border-primary/30 group-data-[variant=secondary]/download:bg-background/70 group-data-[variant=secondary]/download:text-foreground"
  >
    <a
      class="inline-flex min-h-13 items-center justify-center gap-3 rounded-l-lg px-5 py-[13px] text-sm/[inherit] font-medium transition-[background] duration-180 group-data-[compact=true]/download:min-h-[45px] group-data-[compact=true]/download:px-4 group-data-[compact=true]/download:py-3 group-data-[compact=true]/download:text-[13px] hover:bg-primary-hover group-data-[variant=secondary]/download:hover:bg-primary-subtle"
      href="/downloads/"
      data-download-primary
      data-download-email
    >
      {
        ["macos", "windows", "linux", "generic"].map((os) => (
          <span
            class="[&:not([hidden])]:flex"
            data-os-icon={os}
            hidden={os !== "generic"}
          >
            <PlatformIcon os={os} />
          </span>
        ))
      }
      <span data-download-label>Download Quory</span>
    </a>
    <button
      class="grid w-10.5 place-items-center rounded-r-lg border-0 border-l border-primary-foreground/25 bg-transparent p-0 text-inherit transition-[background] duration-180 group-data-[compact=true]/download:w-9 group-data-[variant=secondary]/download:border-primary/20 group-data-[variant=secondary]/download:text-primary-emphasis hover:bg-primary-hover group-data-[variant=secondary]/download:hover:bg-primary-subtle aria-expanded:bg-primary-hover group-data-[variant=secondary]/download:aria-expanded:bg-primary-subtle"
      type="button"
      popovertarget={menuId}
      aria-controls={menuId}
      aria-expanded="false"
      aria-label="Choose another platform"
      data-download-toggle
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
      >
    </button>
  </div>
  <div
    id={menuId}
    class="fixed inset-auto m-0 max-h-[calc(100svh-32px)] w-[min(300px,calc(100vw-32px))] overflow-y-auto rounded-xl border border-border bg-background p-2 text-left text-foreground shadow-[0_16px_48px_rgb(var(--foreground)/0.16)]"
    popover="auto"
    data-download-picker
  >
    <p class="mx-2.5 mt-2 mb-2.5 text-[11px] font-medium text-muted-foreground">
      Download Quory for…
    </p>
    <ul
      class="m-0 list-none p-0 [&_small]:block [&_small]:text-[11px] [&_small]:text-muted-foreground [&_strong]:block [&_strong]:text-[13px] [&_strong]:font-medium"
    >
      {
        targets.map((target) => {
          const asset = fallbackManifest.assets.find((a) => a.id === target.id);
          return (
            <li data-download-option={target.id}>
              <a
                class="items-center gap-3 rounded-md p-2.5 hover:bg-primary-subtle/60 focus-visible:bg-primary-subtle/60 [&:not([hidden])]:flex"
                href={installerPageURL(target.id)}
                hidden={!asset}
                data-download-email
              >
                <PlatformIcon os={target.os} />
                <span>
                  <>
                    <strong>{osNames[target.os as OS]}</strong>
                    <small>{target.label}</small>
                  </>
                </span>
                <span class="ml-auto text-primary-emphasis" aria-hidden="true">
                  ↓
                </span>
              </a>
              <span
                class="unavailable items-center gap-3 rounded-md p-2.5 text-muted-foreground opacity-65 [&:not([hidden])]:flex"
                hidden={!!asset}
              >
                <>
                  <PlatformIcon os={target.os} />
                  <span>
                    <>
                      <strong>
                        {osNames[target.os as OS]} · {target.label}
                      </strong>
                      <small>Coming soon</small>
                    </>
                  </span>
                </>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
<script>
  import {
    browserDevice,
    detectDevice,
    fallbackManifest,
    loadManifest,
    osNames,
    recommendedAsset,
    installerPageURL,
  } from "../lib/downloads";
  const widgets = document.querySelectorAll<HTMLElement>(
    "[data-download-widget]",
  );
  function render(
    manifest: typeof fallbackManifest,
    device: Awaited<ReturnType<typeof browserDevice>>,
  ) {
    const asset = recommendedAsset(manifest, device);
    for (const widget of widgets) {
      const link = widget.querySelector<HTMLAnchorElement>(
        "[data-download-primary]",
      )!;
      link.href = asset
        ? installerPageURL(asset.id)
        : device.os
          ? `/downloads/#${device.os}`
          : "/downloads/";
      link.dataset.hasInstaller = String(!!asset);
      link.title = asset
        ? `Download Quory ${manifest.version} and view installation instructions`
        : "Choose an installer for your computer";
      widget.querySelector("[data-download-label]")!.textContent = device.os
        ? `Download for ${osNames[device.os]}`
        : "Download Quory";
      widget
        .querySelectorAll<HTMLElement>("[data-os-icon]")
        .forEach(
          (icon) =>
            (icon.hidden = icon.dataset.osIcon !== (device.os ?? "generic")),
        );
      widget
        .querySelectorAll<HTMLElement>("[data-download-option]")
        .forEach((option) => {
          const available = manifest.assets.some(
            (a) => a.id === option.dataset.downloadOption,
          );
          option.querySelector<HTMLAnchorElement>("a")!.hidden = !available;
          option.querySelector<HTMLElement>(".unavailable")!.hidden = available;
        });
    }
  }
  for (const widget of widgets) {
    const toggle = widget.querySelector<HTMLButtonElement>(
      "[data-download-toggle]",
    )!;
    const picker = widget.querySelector<HTMLElement>("[data-download-picker]")!;
    const primary = widget.querySelector<HTMLAnchorElement>(
      "[data-download-primary]",
    )!;
    function positionPicker() {
      const rect = widget.getBoundingClientRect();
      const width = Math.min(300, window.innerWidth - 32);
      const height = picker.getBoundingClientRect().height;
      const top =
        rect.bottom + 8 + height <= window.innerHeight - 16
          ? rect.bottom + 8
          : Math.max(16, rect.top - height - 8);
      picker.style.left = `${Math.max(16, Math.min(rect.right - width, window.innerWidth - width - 16))}px`;
      picker.style.top = `${top}px`;
    }
    picker.addEventListener("toggle", () => {
      const open = picker.matches(":popover-open");
      toggle.setAttribute("aria-expanded", String(open));
      if (open) positionPicker();
    });
    window.addEventListener("resize", () => {
      if (picker.matches(":popover-open")) positionPicker();
    });
    document.addEventListener(
      "scroll",
      () => {
        if (picker.matches(":popover-open")) positionPicker();
      },
      { capture: true, passive: true },
    );
    primary.addEventListener("click", (event) => {
      if (
        primary.dataset.hasInstaller === "false" &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.shiftKey &&
        !event.altKey
      ) {
        event.preventDefault();
        picker.showPopover();
        positionPicker();
        picker.querySelector<HTMLAnchorElement>("a:not([hidden])")?.focus();
      }
    });
  }
  render(
    fallbackManifest,
    detectDevice(navigator.userAgent, "", navigator.maxTouchPoints),
  );
  const devicePromise = browserDevice();
  void devicePromise.then((device) => render(fallbackManifest, device));
  void Promise.all([loadManifest(), devicePromise]).then(([manifest, device]) =>
    render(manifest, device),
  );
</script>
