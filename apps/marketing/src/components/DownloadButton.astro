---
import PlatformIcon from "./PlatformIcon.astro";
import {
  fallbackManifest,
  targets,
  osNames,
  installerPageURL,
  type OS,
} from "../lib/downloads";
interface Props {
  compact?: boolean;
  variant?: "primary" | "secondary";
}
const { compact = false, variant = "primary" } = Astro.props;
const menuId = `download-platforms-${crypto.randomUUID()}`;
---

<div
  class:list={["download-widget", variant, { compact }]}
  data-download-widget
>
  <div class="split-button">
    <a
      class="download-button"
      href="/downloads/"
      data-download-primary
      data-download-email
    >
      {
        ["macos", "windows", "linux", "generic"].map((os) => (
          <span data-os-icon={os} hidden={os !== "generic"}>
            <PlatformIcon os={os} />
          </span>
        ))
      }
      <span data-download-label>Download Quory</span>
    </a>
    <button
      class="platform-toggle"
      type="button"
      popovertarget={menuId}
      aria-controls={menuId}
      aria-expanded="false"
      aria-label="Choose another platform"
      data-download-toggle
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg
      >
    </button>
  </div>
  <div id={menuId} class="platform-picker" popover="auto" data-download-picker>
    <p class="picker-heading">Download Quory for…</p>
    <ul>
      {
        targets.map((target) => {
          const asset = fallbackManifest.assets.find((a) => a.id === target.id);
          return (
            <li data-download-option={target.id}>
              <a
                href={installerPageURL(target.id)}
                hidden={!asset}
                data-download-email
              >
                <PlatformIcon os={target.os} />
                <span>
                  <>
                    <strong>{osNames[target.os as OS]}</strong>
                    <small>{target.label}</small>
                  </>
                </span>
                <span class="option-arrow" aria-hidden="true">
                  ↓
                </span>
              </a>
              <span class="unavailable" hidden={!!asset}>
                <>
                  <PlatformIcon os={target.os} />
                  <span>
                    <>
                      <strong>
                        {osNames[target.os as OS]} · {target.label}
                      </strong>
                      <small>Coming soon</small>
                    </>
                  </span>
                </>
              </span>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
<script>
  import {
    browserDevice,
    detectDevice,
    fallbackManifest,
    loadManifest,
    osNames,
    recommendedAsset,
    installerPageURL,
  } from "../lib/downloads";
  const widgets = document.querySelectorAll<HTMLElement>(
    "[data-download-widget]",
  );
  function render(
    manifest: typeof fallbackManifest,
    device: Awaited<ReturnType<typeof browserDevice>>,
  ) {
    const asset = recommendedAsset(manifest, device);
    for (const widget of widgets) {
      const link = widget.querySelector<HTMLAnchorElement>(
        "[data-download-primary]",
      )!;
      link.href = asset
        ? installerPageURL(asset.id)
        : device.os
          ? `/downloads/#${device.os}`
          : "/downloads/";
      link.dataset.hasInstaller = String(!!asset);
      link.title = asset
        ? `Download Quory ${manifest.version} and view installation instructions`
        : "Choose an installer for your computer";
      widget.querySelector("[data-download-label]")!.textContent = device.os
        ? `Download for ${osNames[device.os]}`
        : "Download Quory";
      widget
        .querySelectorAll<HTMLElement>("[data-os-icon]")
        .forEach(
          (icon) =>
            (icon.hidden = icon.dataset.osIcon !== (device.os ?? "generic")),
        );
      widget
        .querySelectorAll<HTMLElement>("[data-download-option]")
        .forEach((option) => {
          const available = manifest.assets.some(
            (a) => a.id === option.dataset.downloadOption,
          );
          option.querySelector<HTMLAnchorElement>("a")!.hidden = !available;
          option.querySelector<HTMLElement>(".unavailable")!.hidden = available;
        });
    }
  }
  for (const widget of widgets) {
    const toggle = widget.querySelector<HTMLButtonElement>(
      "[data-download-toggle]",
    )!;
    const picker = widget.querySelector<HTMLElement>("[data-download-picker]")!;
    const primary = widget.querySelector<HTMLAnchorElement>(
      "[data-download-primary]",
    )!;
    function positionPicker() {
      const rect = widget.getBoundingClientRect();
      const width = Math.min(300, window.innerWidth - 32);
      const height = picker.getBoundingClientRect().height;
      const top =
        rect.bottom + 8 + height <= window.innerHeight - 16
          ? rect.bottom + 8
          : Math.max(16, rect.top - height - 8);
      picker.style.left = `${Math.max(16, Math.min(rect.right - width, window.innerWidth - width - 16))}px`;
      picker.style.top = `${top}px`;
    }
    picker.addEventListener("toggle", () => {
      const open = picker.matches(":popover-open");
      toggle.setAttribute("aria-expanded", String(open));
      if (open) positionPicker();
    });
    window.addEventListener("resize", () => {
      if (picker.matches(":popover-open")) positionPicker();
    });
    document.addEventListener(
      "scroll",
      () => {
        if (picker.matches(":popover-open")) positionPicker();
      },
      { capture: true, passive: true },
    );
    primary.addEventListener("click", (event) => {
      if (
        primary.dataset.hasInstaller === "false" &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.shiftKey &&
        !event.altKey
      ) {
        event.preventDefault();
        picker.showPopover();
        positionPicker();
        picker.querySelector<HTMLAnchorElement>("a:not([hidden])")?.focus();
      }
    });
  }
  render(
    fallbackManifest,
    detectDevice(navigator.userAgent, "", navigator.maxTouchPoints),
  );
  const devicePromise = browserDevice();
  void devicePromise.then((device) => render(fallbackManifest, device));
  void Promise.all([loadManifest(), devicePromise]).then(([manifest, device]) =>
    render(manifest, device),
  );
</script>
<style>
  .download-widget {
    display: inline-flex;
    position: relative;
  }
  .split-button {
    display: inline-flex;
    border-radius: 8px;
    background: rgb(var(--primary));
    color: rgb(var(--primary-foreground));
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 13px 20px;
    border-radius: 8px 0 0 8px;
    font-size: 14px;
    font-weight: 500;
    transition: background 180ms;
  }
  .platform-toggle {
    display: grid;
    place-items: center;
    width: 42px;
    padding: 0;
    border: 0;
    border-left: 1px solid rgb(var(--primary-foreground) / 0.25);
    border-radius: 0 8px 8px 0;
    background: transparent;
    color: inherit;
    transition: background 180ms;
  }
  .download-button:hover,
  .platform-toggle:hover,
  .platform-toggle[aria-expanded="true"] {
    background: rgb(var(--primary-hover));
  }
  [data-os-icon]:not([hidden]) {
    display: flex;
  }
  .platform-picker {
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(300px, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    overflow-y: auto;
    padding: 8px;
    border: 1px solid rgb(var(--border));
    border-radius: 12px;
    background: rgb(var(--background));
    color: rgb(var(--foreground));
    box-shadow: 0 16px 48px rgb(var(--foreground) / 0.16);
    text-align: left;
  }
  .picker-heading {
    margin: 8px 10px 10px;
    font-size: 11px;
    font-weight: 500;
    color: rgb(var(--muted-foreground));
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a:not([hidden]),
  .unavailable:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 6px;
  }
  li a:hover,
  li a:focus-visible {
    background: rgb(var(--primary-subtle) / 0.6);
  }
  li strong {
    display: block;
    font-size: 13px;
    font-weight: 500;
  }
  li small {
    display: block;
    font-size: 11px;
    color: rgb(var(--muted-foreground));
  }
  .option-arrow {
    margin-left: auto;
    color: rgb(var(--primary-emphasis));
  }
  .unavailable {
    color: rgb(var(--muted-foreground));
    opacity: 0.65;
  }
  .compact .download-button {
    min-height: 45px;
    font-size: 13px;
    padding: 12px 16px;
  }
  .compact .platform-toggle {
    width: 36px;
  }
  .secondary .split-button {
    border: 1px solid rgb(var(--primary) / 0.3);
    background: rgb(var(--background) / 0.7);
    color: rgb(var(--foreground));
  }
  .secondary .platform-toggle {
    border-left-color: rgb(var(--primary) / 0.2);
    color: rgb(var(--primary-emphasis));
  }
  .secondary .download-button:hover,
  .secondary .platform-toggle:hover,
  .secondary .platform-toggle[aria-expanded="true"] {
    background: rgb(var(--primary-subtle));
  }
</style>
