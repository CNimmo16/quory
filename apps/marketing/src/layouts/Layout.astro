---
import "../styles/global.css";
import GitHubLink from "../components/GitHubLink.astro";
import DownloadEmailModal from "../components/DownloadEmailModal.astro";
import iconUrl from "../../../../packages/config/branding/quory-icon.svg?url";
import logoUrl from "../../../../packages/config/branding/quory-logo.svg?url";
import palette from "../../../../packages/config/theme/palette.json";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Quory — Follow the data. Find the answer.",
  description = "The open source database client for support engineers. Explore related data, understand the full customer story, and get back to helping people.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={palette.light.background}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={palette.dark.background}
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
    <title>{title}</title>
  </head>
  <body class="bg-background font-sans text-foreground">
    <a
      class="fixed top-[10px] left-[10px] z-20 [transform:translateY(-150%)] bg-primary px-[18px] py-[10px] text-primary-foreground focus:[transform:translateY(0)]"
      href="#main"
    >
      Skip to content
    </a>
    <header
      class="mx-auto flex h-[110px] w-[min(1240px,_calc(100%_-_96px))] items-center justify-between border-b border-solid border-border max-[1100px]:w-[calc(100%_-_64px)] max-[780px]:h-[83px] max-[780px]:w-[calc(100%_-_40px)] max-[520px]:w-[calc(100%_-_36px)]"
    >
      <a
        class="inline-flex shrink-0 items-center"
        href="/"
        aria-label="Quory home"
      >
        <img
          class="h-10 w-auto max-[780px]:h-[34px] max-[520px]:h-[30px]"
          src={logoUrl}
          width="120"
          height="40"
          alt=""
        />
      </a>
      <nav
        class="flex items-center gap-[34px] text-[14px] font-medium max-[780px]:gap-[18px] max-[780px]:text-[12px] max-[520px]:gap-3"
        aria-label="Main navigation"
      >
        <a
          class="hover:text-primary-emphasis hover:underline hover:underline-offset-[5px] max-[520px]:hidden"
          href="/#why-quory"
        >
          Why Quory
        </a>
        <a
          class="hover:text-primary-emphasis hover:underline hover:underline-offset-[5px]"
          href="/docs/"
          aria-current={Astro.url.pathname.startsWith("/docs")
            ? "page"
            : undefined}
        >
          Docs
        </a>
        <a
          href="/downloads/"
          class="hover:text-primary-emphasis hover:underline hover:underline-offset-[5px]"
          aria-current={Astro.url.pathname === "/downloads/"
            ? "page"
            : undefined}>Downloads</a
        >
        <a href="/#cloud" class="group relative hover:text-primary-emphasis">
          <span class="underline-offset-[5px] group-hover:underline">Cloud</span
          >
          <span
            class="absolute bottom-[calc(100%-8px)] left-[calc(100%+3px)] rounded border border-solid border-secondary px-[4px] py-[0.5px] text-[9px] tracking-[0.6px] text-secondary-emphasis uppercase group-hover:bg-secondary-subtle/50 max-[780px]:hidden"
          >
            Soon
          </span>
        </a>
      </nav>
      <GitHubLink compactOnMobile />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer
      class="mx-auto flex w-[min(1240px,_calc(100%_-_96px))] justify-between gap-5 border-t border-solid border-border px-0 pt-[33px] pb-[35px] max-[1100px]:w-[calc(100%_-_64px)] max-[780px]:w-[calc(100%_-_40px)] max-[780px]:py-7 max-[520px]:w-[calc(100%_-_36px)] max-[520px]:flex-col max-[520px]:gap-[23px]"
    >
      <div>
        <a class="inline-flex items-center" href="/" aria-label="Quory home">
          <img class="h-8 w-auto" src={logoUrl} width="96" height="32" alt="" />
        </a>
      </div>
      <div class="text-right max-[520px]:text-left">
        <div
          class="flex justify-end gap-[27px] text-[11px] max-[520px]:justify-start"
        >
          <a
            class="hover:text-primary-emphasis hover:underline hover:underline-offset-[5px]"
            href="/docs/"
          >
            Docs
          </a>
          <a
            class="hover:text-primary-emphasis hover:underline hover:underline-offset-[5px]"
            href="https://github.com/CNimmo16/quory"
          >
            Source on GitHub ↗
          </a>
        </div>
        <p class="mx-0 mt-3 mb-0 text-[10px] text-muted-foreground">
          Open source, built for engineers by engineers.
        </p>
      </div>
    </footer>
    <DownloadEmailModal />
  </body>
</html>
