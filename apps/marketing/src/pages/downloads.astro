---
import Layout from "../layouts/Layout.astro";
import DownloadButton from "../components/DownloadButton.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import {
  fallbackManifest,
  fileSize,
  targets,
  installerPageURL,
} from "../lib/downloads";
const platforms = [
  {
    os: "macos",
    name: "macOS",
    detail: "Choose the chip in your Mac.",
    help: "In the Apple menu, choose About This Mac. Look for Apple M-series or Intel under Chip or Processor.",
  },
  {
    os: "windows",
    name: "Windows",
    detail: "An installer for your PC.",
    help: "The current installer is for Intel and AMD 64-bit PCs. A native Windows ARM installer is not available yet.",
  },
  {
    os: "linux",
    name: "Linux",
    detail: "Choose your preferred package.",
    help: "For Intel and AMD 64-bit Linux systems. ARM devices, including Raspberry Pi, are not supported by these builds.",
  },
];
---

<Layout
  title="Download Quory — macOS, Windows & Linux"
  description="Download Quory for macOS, Windows and Linux. Choose your installer and get help installing the early-access desktop app."
>
  <div
    class="mx-auto w-[min(1240px,calc(100%-96px))] pt-18 pb-24 max-[1100px]:w-[calc(100%-64px)] max-[780px]:w-[calc(100%-40px)] max-[780px]:pt-10"
  >
    <header class="mx-auto mb-12 max-w-175 text-center">
      <h1
        class="my-5.5 font-display text-[clamp(52px,6vw,80px)] leading-none font-normal"
      >
        Download Quory
      </h1>
      <p class="mx-auto mb-7 max-w-115 text-[15px] text-muted-foreground">
        The first ever database client built for early-stage engineers.
      </p>
      <DownloadButton />
      <p
        class="mt-3.5 mb-0 text-[11px] text-muted-foreground"
        data-release-version
      >
        Version {fallbackManifest.version}
      </p>
    </header>
    <aside
      class="mb-8 flex gap-5 rounded-xl bg-primary-subtle/45 px-7 py-6 max-[780px]:gap-3 max-[780px]:p-5 [&_p]:mt-[5px] [&_p]:mb-0 [&_p]:text-[13px] [&_p]:text-muted-foreground [&_strong]:text-sm/[inherit] [&_strong]:font-medium [&>span]:text-[26px] [&>span]:text-primary"
    >
      <span aria-hidden="true">↳</span>
      <div>
        <strong>A note before you install</strong><p>
          These early-access installers aren’t publisher-signed or notarized.
          macOS and Windows may display a security warning or block
          installation. Read the instructions below, especially if you’re using
          a company-managed computer.
        </p>
      </div>
    </aside>
    <div
      class="grid grid-cols-3 gap-5 max-[780px]:grid-cols-1"
      id="platform-downloads"
    >
      {
        platforms.map((platform) => (
          <section
            class="scroll-mt-7 rounded-2xl border border-border p-7 data-[detected]:border-primary max-[1100px]:p-5.5"
            id={platform.os}
            aria-labelledby={`${platform.os}-title`}
          >
            <div class="flex items-center gap-3.5">
              <>
                <PlatformIcon os={platform.os} />
                <h2
                  class="m-0 font-display text-[34px] font-medium"
                  id={`${platform.os}-title`}
                >
                  {platform.name}
                </h2>
              </>
            </div>
            <p class="mt-2 mb-6 text-xs/[inherit] text-muted-foreground">
              {platform.detail}
            </p>
            <div>
              {targets
                .filter((t) => t.os === platform.os)
                .map((target) => {
                  const asset = fallbackManifest.assets.find(
                    (a) => a.id === target.id,
                  );
                  return (
                    <div
                      class="not-first:mt-5 not-first:border-t not-first:border-border not-first:pt-5"
                      data-asset-id={target.id}
                    >
                      <a
                        class="asset-link items-center justify-between gap-2 text-[13px] font-medium text-primary-emphasis hover:underline hover:underline-offset-4 [&:not([hidden])]:flex"
                        href={asset ? installerPageURL(target.id) : undefined}
                        data-download-email
                        hidden={!asset}
                      >
                        <span>{target.label}</span>
                        <span aria-hidden="true">↓</span>
                      </a>
                      <span
                        class="asset-unavailable text-xs/[inherit] text-muted-foreground"
                        hidden={!!asset}
                      >
                        {target.label} · Not available yet
                      </span>
                      <span class="asset-meta mt-[5px] block text-[11px] text-muted-foreground">
                        {asset
                          ? `${target.format === "AppImage" ? "AppImage" : `.${target.format}`} · ${fileSize(asset.size)}`
                          : "This build will appear here when it’s released."}
                      </span>
                      <details
                        class="checksum mt-2.5 text-[10px] text-muted-foreground [&_code]:mt-2 [&_code]:block [&_code]:wrap-anywhere [&_summary]:cursor-pointer"
                        hidden={!asset?.sha256}
                      >
                        <summary>SHA-256 checksum</summary>
                        <code>{asset?.sha256}</code>
                      </details>
                    </div>
                  );
                })}
            </div>
            <p class="mt-6.5 mb-0 text-xs/[1.8] text-muted-foreground">
              {platform.help}
            </p>
          </section>
        ))
      }
    </div>
    <section
      class="mt-18 grid grid-cols-[0.8fr_1.2fr] gap-16 max-[780px]:mt-12 max-[780px]:grid-cols-1 max-[780px]:gap-3"
      aria-labelledby="install-title"
    >
      <div>
        <h2
          class="my-5 font-display text-[42px] leading-[1.1] font-medium"
          id="install-title"
        >
          How to install Quory
        </h2>
      </div>
      <div
        class="[&_a]:underline [&_a]:underline-offset-4 [&_details]:border-b [&_details]:border-border [&_details]:py-5 [&_details>div]:text-[13px] [&_details>div]:leading-[1.9] [&_details>div]:text-muted-foreground [&_li+li]:mt-2 [&_ol]:pl-5 [&_summary]:cursor-pointer [&_summary]:text-[15px]"
      >
        <details open>
          <summary>Installing on macOS</summary>
          <div>
            <ol>
              <li>
                Download the disk image for your Mac’s chip, open it, and drag
                Quory into Applications.
              </li><li>
                Open Quory from Applications. If macOS blocks this unidentified
                or unnotarized app, review the warning.
              </li><li>
                If you trust the download, open System Settings → Privacy &amp;
                Security and look for Open Anyway. Confirm the app is Quory.
              </li>
            </ol><p>
              This option may not be available on managed Macs. If the app is
              reported as damaged or malicious, stop and report the issue rather
              than disabling security protections.
            </p><a href="https://support.apple.com/en-us/102445"
              >Apple’s installation guidance ↗</a
            >
          </div>
        </details>
        <details>
          <summary>Installing on Windows</summary>
          <div>
            <p>
              Download and run the .exe installer. Windows may show an
              unknown-publisher or SmartScreen warning. Review the source before
              proceeding. When permitted, SmartScreen offers More info → Run
              anyway.
            </p><p>
              Smart App Control or your organization’s policies may block an
              unsigned installer entirely. Ask your IT team for help; don’t
              disable those protections to install Quory.
            </p>
          </div>
        </details>
        <details>
          <summary>Installing on Linux</summary>
          <div>
            <p>
              For AppImage, open the downloaded file’s properties and allow it
              to run as a program, then launch it. Some distributions need FUSE
              compatibility packages.
            </p><p>
              For Debian or Ubuntu, open the .deb in your software installer.
              Other distributions should use the AppImage. Library and sandbox
              requirements vary by distribution; report launch errors rather
              than disabling the sandbox.
            </p>
          </div>
        </details>
        <details>
          <summary>Updates and compatibility</summary>
          <div>
            <p>
              Updates are manual during early access. Return here to download a
              newer version and quit Quory before installing it. Back up
              important local app data before upgrading.
            </p><p>
              Quory is a desktop app. Mobile devices and ChromeOS aren’t
              supported. OS detection is only a suggestion; use the platform
              choices above if it gets your computer wrong.
            </p><a href="https://github.com/CNimmo16/quory/issues"
              >Report an installation issue ↗</a
            >
          </div>
        </details>
      </div>
    </section>
  </div>
</Layout>
<script>
  import {
    browserDevice,
    installerPageURL,
    fileSize,
    loadManifest,
    targets,
  } from "../lib/downloads";
  void loadManifest().then((manifest) => {
    document.querySelector("[data-release-version]")!.textContent =
      `Version ${manifest.version}`;
    document.querySelectorAll<HTMLElement>("[data-asset-id]").forEach((row) => {
      const asset = manifest.assets.find((a) => a.id === row.dataset.assetId);
      const target = targets.find((t) => t.id === row.dataset.assetId)!;
      const link = row.querySelector<HTMLAnchorElement>(".asset-link")!;
      link.hidden = !asset;
      row.querySelector<HTMLElement>(".asset-unavailable")!.hidden = !!asset;
      if (asset) link.href = installerPageURL(asset.id);
      else link.removeAttribute("href");
      row.querySelector(".asset-meta")!.textContent = asset
        ? `${target.format === "AppImage" ? "AppImage" : `.${target.format}`} · ${fileSize(asset.size)}`
        : "This build will appear here when it’s released.";
      row.querySelector<HTMLElement>(".checksum")!.hidden = !asset?.sha256;
      row.querySelector("code")!.textContent = asset?.sha256 ?? "";
    });
  });
  void browserDevice().then((device) => {
    if (device.os)
      document.getElementById(device.os)?.setAttribute("data-detected", "true");
  });
</script>
