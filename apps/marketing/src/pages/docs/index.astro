---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Documentation — Quory"
  description="A dedicated home for Quory’s documentation is on the way. In the meantime, the project README has instructions to get you started."
>
  <section
    class="mx-auto w-[min(1240px,_calc(100%_-_96px))] pt-[50px] pb-[65px] max-[1100px]:w-[calc(100%_-_64px)] max-[780px]:w-[calc(100%_-_40px)] max-[520px]:w-[calc(100%_-_36px)] max-[520px]:pt-[30px] max-[520px]:pb-10"
  >
    <a
      class="mb-[65px] inline-block text-[12px] text-muted-foreground hover:text-primary-emphasis hover:underline hover:underline-offset-[5px] max-[520px]:mb-[42px]"
      href="/"
    >
      ← Back to Quory
    </a>
    <p
      class="mx-0 mt-0 mb-5 flex items-center gap-[9px] text-[11px] font-[650] tracking-[1.15px] text-primary-emphasis uppercase max-[520px]:text-[9px] max-[520px]:tracking-[0.7px]"
    >
      The Quory field guide
    </p>
    <h1
      class="mx-0 mt-0 mb-[25px] max-w-185 font-display text-[60px] leading-[1.2] font-[550] tracking-[-2.5px] max-[780px]:text-[48px] max-[520px]:text-[42px] max-[520px]:tracking-[-2px]"
    >
      Good answers start here.
    </h1>
    <p
      class="max-w-140 text-[16px] leading-[1.8] text-muted-foreground max-[520px]:text-[14px]"
    >
      A dedicated home for Quory’s documentation is on the way. In the meantime,
      the project README has instructions to get you started.
    </p>
    <span
      class="inline-block rounded-[20px] border border-solid border-border bg-muted px-[9px] py-[3px] align-middle text-[9px] leading-[1.6] font-medium tracking-[0] text-muted-foreground normal-case"
    >
      Documentation coming soon
    </span>
    <div class="mt-7">
      <a
        class="inline-flex min-h-13 items-center justify-center gap-[26px] rounded-[7px] bg-primary px-[23px] py-[13px] text-[14px] font-[550] text-primary-foreground [transition:background_0.2s,_transform_0.2s] hover:[transform:translateY(-2px)] hover:bg-primary-hover max-[520px]:gap-[18px] max-[520px]:text-[12px]"
        href="https://github.com/CNimmo16/quory#readme"
      >
        Read the getting started guide
        <span class="text-[20px] leading-none" aria-hidden="true"> ↗</span>
      </a>
    </div>
  </section>
  <section
    class="mx-auto grid w-[min(1240px,_calc(100%_-_96px))] grid-cols-[repeat(3,_1fr)] gap-[35px] pb-25 max-[1100px]:w-[calc(100%_-_64px)] max-[780px]:w-[calc(100%_-_40px)] max-[780px]:gap-[25px] max-[520px]:w-[calc(100%_-_36px)] max-[520px]:grid-cols-[1fr] max-[520px]:pb-15"
    aria-label="Upcoming documentation"
  >
    <article class="border-t border-solid border-border pt-[22px]">
      <span class="font-mono text-[11px] leading-[2.5] text-muted-foreground">
        01
      </span>
      <h2
        class="mx-0 my-[10px] font-display text-[21px] leading-[1.3] font-normal tracking-[-0.6px] max-[780px]:text-[18px] max-[520px]:text-[22px]"
      >
        Getting started
      </h2>
      <p
        class="max-w-70 text-[13px] leading-[1.8] text-muted-foreground max-[520px]:max-w-none"
      >
        Install Quory and make your first database connection.
      </p>
      <span class="text-[10px] text-muted-foreground">Coming soon</span>
    </article>
    <article class="border-t border-solid border-border pt-[22px]">
      <span class="font-mono text-[11px] leading-[2.5] text-muted-foreground">
        02
      </span>
      <h2
        class="mx-0 my-[10px] font-display text-[21px] leading-[1.3] font-normal tracking-[-0.6px] max-[780px]:text-[18px] max-[520px]:text-[22px]"
      >
        Exploring relationships
      </h2>
      <p
        class="max-w-70 text-[13px] leading-[1.8] text-muted-foreground max-[520px]:max-w-none"
      >
        Learn how Quory connects data across your tables.
      </p>
      <span class="text-[10px] text-muted-foreground">Coming soon</span>
    </article>
    <article class="border-t border-solid border-border pt-[22px]">
      <span class="font-mono text-[11px] leading-[2.5] text-muted-foreground">
        03
      </span>
      <h2
        class="mx-0 my-[10px] font-display text-[21px] leading-[1.3] font-normal tracking-[-0.6px] max-[780px]:text-[18px] max-[520px]:text-[22px]"
      >
        Building with Quory
      </h2>
      <p
        class="max-w-70 text-[13px] leading-[1.8] text-muted-foreground max-[520px]:max-w-none"
      >
        Explore the core library and embed Quory in your own app.
      </p>
      <span class="text-[10px] text-muted-foreground">Coming soon</span>
    </article>
  </section>
</Layout>
