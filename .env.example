# AI SDK provider: openai, anthropic, google, or custom. Use a model that supports tools.
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna

OPENAI_API_KEY=
# OPEN_AI_API_KEY is also accepted for existing local configurations.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Custom OpenAI-compatible Chat Completions endpoint (used only with AI_PROVIDER=custom).
# AI_BASE_URL=http://localhost:1234/v1
# CUSTOM_OPENAI_API_KEY=
