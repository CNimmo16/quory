{
  "version": 1,
  "id": "recent-rentals",
  "nickname": "Rentals since August 2005",
  "base": {
    "tableRef": "sakila.rental",
    "select": ["rental_id", "rental_date", "return_date"],
    "where": {
      "column": "rental_date",
      "operator": ">=",
      "value": "2005-08-01"
    },
    "orderBy": [
      {
        "column": "rental_date",
        "direction": "desc"
      }
    ],
    "joins": [
      {
        "tableRef": "sakila.customer",
        "select": ["customer_id", "first_name", "last_name", "email"]
      },
      {
        "tableRef": "sakila.inventory",
        "select": ["inventory_id", "store_id"],
        "joins": [
          {
            "tableRef": "sakila.film",
            "select": ["title", "rating"]
          }
        ]
      },
      {
        "tableRef": "sakila.staff",
        "select": ["first_name", "last_name"]
      }
    ]
  },
  "limit": 100,
  "offset": 0
}
