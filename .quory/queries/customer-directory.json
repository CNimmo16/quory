{
  "version": 1,
  "id": "customer-directory",
  "nickname": "Customers and addresses",
  "base": {
    "tableRef": "sakila.customer",
    "select": ["customer_id", "first_name", "last_name", "email", "active"],
    "orderBy": [
      {
        "column": "last_name",
        "direction": "asc"
      }
    ],
    "joins": [
      {
        "tableRef": "sakila.address",
        "select": ["address", "district", "postal_code", "phone"],
        "joins": [
          {
            "tableRef": "sakila.city",
            "select": ["city"],
            "joins": [
              {
                "tableRef": "sakila.country",
                "select": ["country"]
              }
            ]
          }
        ]
      }
    ]
  },
  "limit": 100,
  "offset": 0
}
